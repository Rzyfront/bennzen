# Proveedor de voz por API (opcional). Si se deja vacío, la app usa SOLO la voz
# del navegador (Web Speech / SpeechSynthesis). El orquestador carga este .env
# al arrancar (process.loadEnvFile). Las keys NUNCA llegan al navegador.

# --- STT (voz → texto) ---
# Proveedor: openai | groq | generic | none
STT_PROVIDER=none
# Preset OpenAI (Whisper / gpt-4o-transcribe):
OPENAI_API_KEY=
STT_MODEL=whisper-1
# Modo genérico (cualquier endpoint que reciba audio multipart y devuelva {text}):
STT_URL=
STT_AUTH_HEADER=
# Groq (OpenAI-compatible). STT_PROVIDER=groq + GROQ_API_KEY.
# Modelos: whisper-large-v3-turbo (rápido) | whisper-large-v3.
GROQ_API_KEY=
# Base URL de Groq (opcional; por defecto https://api.groq.com/openai/v1):
GROQ_STT_URL=https://api.groq.com/openai/v1

# --- TTS (texto → voz) ---
# Proveedor: openai | generic | minimax | none
TTS_PROVIDER=none
# Preset OpenAI (tts-1 / gpt-4o-mini-tts):
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Modo genérico (endpoint que reciba {text} y devuelva audio/*):
TTS_URL=
TTS_AUTH_HEADER=
# MiniMax T2A (propio: devuelve audio hex-encoded). TTS_PROVIDER=minimax + MINIMAX_API_KEY.
# La MISMA key de MiniMax que usa el proxy `mini` (MINI_AUTH_TOKEN, sk-cp-...)
# sirve también para T2A (verificado). Si dejas MINIMAX_API_KEY vacío, el proxy
# reusa MINI_AUTH_TOKEN automáticamente. El idioma se fuerza con VOICE_LANG (es-ES → Spanish).
MINIMAX_API_KEY=
# Endpoint T2A (opcional; por defecto https://api.minimax.io/v1/t2a_v2):
MINIMAX_TTS_URL=https://api.minimax.io/v1/t2a_v2
# Modelo TTS: speech-2.8-hd | speech-2.8-turbo | speech-2.6-hd | speech-2.6-turbo
# Voice ID: las voces HD son multilingües; English_expressive_narrator lee español
# con language_boost=Spanish (derivado de VOICE_LANG). Para timbre nativo, busca un
# voice_id español en platform.minimax.io/docs/voice-library y ponlo en el campo voz del modal.

# Idioma por defecto del reconocimiento del navegador
VOICE_LANG=es-ES

# --- Limpieza de texto (cleanup LLM opcional) ---
# LLM OpenAI-compatible que limpia/compacta el texto del agente antes del TTS.
# Compatible con OpenRouter, OpenAI, Groq, Ollama (con /v1), etc.
# Si se deja vacío, el cleanup se configura desde el modal de la PWA (cabeceras x-voice-clean-*).
# El prompt default vive en el servidor (DEFAULT_CLEANUP_PROMPT en voice-proxy.ts);
# aquí solo se sobreescribe si quieres uno distinto.
CLEANUP_URL=https://openrouter.ai/api/v1
CLEANUP_MODEL=
CLEANUP_API_KEY=
CLEANUP_PROMPT=

# --- Agentes proxy de Claude Code (mini / qwen) ---
# mini y qwen no son binarios: son `claude` con env que repuntan la API.
# El orquestador los lanza como `claude` + estas vars (ver orchestrator/adapters/claude-proxy-env.ts).
#
# mini → MiniMax. El token es SECRETO: ponlo SOLO aquí (.env está gitignorado,
# nunca llega al navegador ni a git). Sin MINI_AUTH_TOKEN, `mini` falla al arrancar.
# Cópialo de la función mini() de tu ~/.zshrc.
MINI_AUTH_TOKEN=
#
# qwen → Qwen vía Alibaba Bailian (endpoint Anthropic-compatible).
# La key se busca PRIMERO aquí y, si falta, en el Keychain de macOS (servicio
# `bailian-api`), el mismo que usa la función qwen() de ~/.zshrc:
#   security add-generic-password -U -s bailian-api -a "$USER" -w '<sk-...>'
# Con la key en el Keychain, deja las dos vars comentadas.
# BAILIAN_API_KEY=
# BAILIAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
#
# Contexto de 1M por defecto en TODOS los alias: ambos modelos llevan sufijo
# [1m] (qwen3.8-max[1m], deepseek-v4-flash-0731[1m]) y
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=500000 dispara el auto-compact a la mitad
# del 1M para ahorrar coste en sesiones largas.
# Descomenta para sobreescribir un modelo (p.ej. si Bailian rechaza el sufijo):
# BAILIAN_MODEL=qwen3.8-max
# BAILIAN_SONNET_MODEL=deepseek-v4-flash-0731
