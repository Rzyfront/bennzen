{
  "name": "bennzen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cliente de voz delgado sobre agentes CLI (Claude Code / Codex / OpenCode)",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "orchestrator": "tsx watch orchestrator/server.ts",
    "pwa": "vite",
    "dev": "concurrently -k -n ORCH,PWA -c blue,green \"npm:orchestrator\" \"npm:pwa\"",
    "typecheck": "tsc --noEmit",
    "build:pwa": "vite build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.183",
    "@opencode-ai/sdk": "^1.17.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "strip-ansi": "^7.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
